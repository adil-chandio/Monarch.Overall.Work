# Optional: provision a dedicated Monarch Supabase project before using cloud mode.
# Do not use the unrelated Supabase project already used by another application.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- yt_intel (server-side only) -------------------------------------------------
# Free YouTube Data API v3 key. 5-minute setup: docs/setup/YOUTUBE-API-KEY.md
# NEVER prefix this with VITE_ — that would ship it to the browser bundle.
YOUTUBE_API_KEY=
