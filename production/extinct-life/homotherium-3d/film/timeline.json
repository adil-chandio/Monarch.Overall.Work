    {
      "start": 0.25,
      "end": 3.815,
      "lines": [
        "This saber-toothed cub",
        "is over 35,000 years old."
      ]
    },
    {
      "start": 4.318,
      "end": 6.268,
      "lines": [
        "And its fur",
        "is still here."
      ]
    },
    {
      "start": 6.749,
      "end": 8.604,
      "lines": [
        "Found in Siberian permafrost,"
      ]
    },
    {
      "start": 9.082,
      "end": 10.716,
      "lines": [
        "these are preserved remains,"
      ]
    },
    {
      "start": 11.197,
      "end": 12.436,
      "lines": [
        "not a living animal."
      ]
    },
    {
      "start": 12.932,
      "end": 15.589,
      "lines": [
        "Scientists studied",
        "its skull and teeth"
      ]
    },
    {
      "start": 15.901,
      "end": 17.285,
      "lines": [
        "using CT imaging."
      ]
    },
    {
      "start": 17.735,
      "end": 20.097,
      "lines": [
        "The animal was Homotherium,"
      ]
    },
    {
      "start": 20.535,
      "end": 22.755,
      "lines": [
        "an extinct saber-toothed cat."
      ]
    },
    {
      "start": 23.195,
      "end": 26.913,
      "lines": [
        "Its tooth development suggests",
        "it was only about three weeks old."
      ]
    },
    {
      "start": 27.379,
      "end": 29.621,
      "lines": [
        "Compared with a",
        "similar-aged lion cub,"
      ]
    },
    {
      "start": 30.07,
      "end": 31.338,
      "lines": [
        "it had smaller ears,"
      ]
    },
    {
      "start": 31.661,
      "end": 32.522,
      "lines": [
        "a powerful neck,"
      ]
    },
    {
      "start": 32.832,
      "end": 34.26,
      "lines": [
        "and broader front paws."
      ]
    },
    {
      "start": 34.728,
      "end": 38.546,
      "lines": [
        "Those soft-tissue details are things",
        "a bare skeleton cannot show."
      ]
    },
    {
      "start": 39.045,
      "end": 40.542,
      "lines": [
        "But the mummy is incomplete."
      ]
    },
    {
      "start": 41.04,
      "end": 43.574,
      "lines": [
        "A full living appearance",
        "still needs reconstruction."
      ]
    },
    {
      "start": 44.053,
      "end": 45.278,
      "lines": [
        "Not a resurrected predator."
      ]
    },
    {
      "start": 45.709,
      "end": 47.636,
      "lines": [
        "A tiny survivor of deep time,"
      ]
    },
    {
      "start": 48.142,
      "end": 50.073,
      "lines": [
        "revealing what bones alone",
        "leave out."
      ]
    }
  ],
