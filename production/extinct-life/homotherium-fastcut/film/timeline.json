  "captions": [
    {
      "start": 0.12,
      "end": 1.7887,
      "text": "This saber-toothed cub"
    },
    {
      "start": 1.7887,
      "end": 3.685,
      "text": "is over 35,000 years old."
    },
    {
      "start": 3.895,
      "end": 4.753,
      "text": "And its fur"
    },
    {
      "start": 4.753,
      "end": 5.845,
      "text": "is still here."
    },
    {
      "start": 6.055,
      "end": 7.91,
      "text": "Found in Siberian permafrost,"
    },
    {
      "start": 8.12,
      "end": 9.754,
      "text": "these are preserved remains,"
    },
    {
      "start": 9.964,
      "end": 11.203,
      "text": "not a living animal."
    },
    {
      "start": 11.413,
      "end": 12.7056,
      "text": "Scientists studied"
    },
    {
      "start": 12.7056,
      "end": 14.07,
      "text": "its skull and teeth"
    },
    {
      "start": 14.28,
      "end": 15.664,
      "text": "using CT imaging."
    },
    {
      "start": 15.874,
      "end": 18.236,
      "text": "The animal was Homotherium,"
    },
    {
      "start": 18.446,
      "end": 20.666,
      "text": "an extinct saber-toothed cat."
    },
    {
      "start": 20.876,
      "end": 22.6465,
      "text": "Its tooth development suggests"
    },
    {
      "start": 22.6465,
      "end": 23.6497,
      "text": "it was only about"
    },
    {
      "start": 23.6497,
      "end": 24.594,
      "text": "three weeks old."
    },
    {
      "start": 24.804,
      "end": 25.7129,
      "text": "Compared with a"
    },
    {
      "start": 25.7129,
      "end": 27.046,
      "text": "similar-aged lion cub,"
    },
    {
      "start": 27.256,
      "end": 28.524,
      "text": "it had smaller ears,"
    },
    {
      "start": 28.734,
      "end": 29.595,
      "text": "a powerful neck,"
    },
    {
      "start": 29.805,
      "end": 31.233,
      "text": "and broader front paws."
    },
    {
      "start": 31.443,
      "end": 33.5906,
      "text": "Those soft-tissue details are things"
    },
    {
      "start": 33.5906,
      "end": 35.261,
      "text": "a bare skeleton cannot show."
    },
    {
      "start": 35.471,
      "end": 36.968,
      "text": "But the mummy is incomplete."
    },
    {
      "start": 37.178,
      "end": 38.3705,
      "text": "A full living appearance"
    },
    {
      "start": 38.3705,
      "end": 39.712,
      "text": "still needs reconstruction."
    },
    {
      "start": 39.922,
      "end": 41.147,
      "text": "Not a resurrected predator."
    },
    {
      "start": 41.357,
      "end": 42.3893,
      "text": "A tiny survivor"
    },
    {
      "start": 42.3893,
      "end": 43.284,
      "text": "of deep time,"
    },
    {
      "start": 43.494,
      "end": 44.8886,
      "text": "revealing what bones alone"
    },
    {
      "start": 44.8886,
      "end": 45.425,
      "text": "leave out."
    }
  ],
