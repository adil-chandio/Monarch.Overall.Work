    },
    {
      "id": "vo2",
      "start": 2.3,
      "text": "Number five: a squirrel drops in.",
      "caption": "THE DROP-IN."
    },
    {
      "id": "vo3",
      "start": 5.3,
      "text": "Tiny paws. Zero hesitation.",
      "caption": "ZERO HESITATION."
    },
    {
      "id": "vo4",
      "start": 8.3,
      "text": "Number four: a crab in a broken shell.",
      "caption": "THE TINY COMMUTE."
    },
    {
      "id": "vo5",
      "start": 11.3,
      "text": "Still moving. Still improvising.",
      "caption": "STILL MOVING."
    },
    {
      "id": "vo6",
      "start": 14.3,
      "text": "Number three: a starfish flips over.",
      "caption": "THE SLOW FLIP."
    },
    {
      "id": "vo7",
      "start": 17.3,
      "text": "Slow, then suddenly fast.",
      "caption": "SUDDENLY FAST."
    },
    {
      "id": "vo8",
      "start": 20.3,
      "text": "Number two: an octopus opens a bottle.",
      "caption": "THE BOTTLE OPENER."
    },
    {
      "id": "vo9",
      "start": 23.3,
      "text": "Eight arms. One problem solved.",
      "caption": "EIGHT ARMS."
    },
    {
      "id": "vo10",
      "start": 26.3,
      "text": "Number one: a titmouse lands on a hand.",
      "caption": "THE HAND LANDING."
    },
    {
      "id": "vo11",
      "start": 29.3,
      "text": "Wild, but willing to trust.",
      "caption": "WILD TRUST."
    },
    {
      "id": "vo12",
      "start": 32.0,
      "text": "Which rank would you change?",
      "caption": "WHICH RANK?"
    },
    {
      "id": "vo13",
