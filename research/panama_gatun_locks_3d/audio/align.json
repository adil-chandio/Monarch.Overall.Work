 "captions": [
  {
   "sentence": 0,
   "text": "This ship is",
   "start": 0.0,
   "end": 1.183
  },
  {
   "sentence": 0,
   "text": "about to",
   "start": 1.203,
   "end": 2.263
  },
  {
   "sentence": 0,
   "text": "climb a mountain.",
   "start": 2.283,
   "end": 3.3
  },
  {
   "sentence": 1,
   "text": "No crane.",
   "start": 3.32,
   "end": 4.387
  },
  {
   "sentence": 2,
   "text": "No elevator. Just water.",
   "start": 4.407,
   "end": 5.502
  },
  {
   "sentence": 4,
   "text": "At Gatun three pairs",
   "start": 5.539,
   "end": 6.678
  },
  {
   "sentence": 4,
   "text": "of chambers",
   "start": 6.698,
   "end": 7.366
  },
  {
   "sentence": 4,
   "text": "climb eighty-five feet.",
   "start": 7.386,
   "end": 8.304
  },
  {
   "sentence": 5,
   "text": "Steel gates seal the",
   "start": 8.324,
   "end": 9.573
  },
  {
   "sentence": 5,
   "text": "ship inside and the water does the rest.",
   "start": 9.613,
   "end": 11.865
  },
  {
   "sentence": 6,
   "text": "Open the valves",
   "start": 11.885,
   "end": 13.505
  },
  {
   "sentence": 6,
   "text": "and the water pours",
   "start": 13.525,
   "end": 14.485
  },
  {
   "sentence": 6,
   "text": "down through tunnels",
   "start": 14.505,
   "end": 16.113
  },
  {
   "sentence": 6,
   "text": "inside the walls then",
   "start": 16.133,
   "end": 17.763
  },
  {
   "sentence": 6,
   "text": "rises through a hundred",
   "start": 17.783,
   "end": 19.179
  },
  {
   "sentence": 6,
   "text": "holes in the floor. The ship",
   "start": 19.199,
   "end": 22.006
  },
  {
   "sentence": 7,
   "text": "floats up with it.",
   "start": 22.147,
   "end": 23.665
